  {
    "name": "iconic-rotating-bar-curve.liquid",
    "author": "Arham Web Works",
    "description": "Copying in any form is strictly prohibited. Any instance of copying will be subject to legal action and accountability under the law."
  }
{%- endcomment -%}

{% liquid
  assign horizontal_offset = section.settings.boxshadow_horizontal_offset
  assign vertical_offset = section.settings.boxshadow_vertical_offset
  assign blur_radius = section.settings.boxshadow_blur
  assign shadow_spread = section.settings.boxshadow_spread
  assign shadow_color = section.settings.boxshadow_color | color_to_rgb | split: 'rgb(' | last | split: ')' | first
  assign shadow_opacity = section.settings.boxshadow_opacity | divided_by: 100.0
%}

{% style %}
  #iconic-rotatingbar-curve-{{ section.id }} .iconic-container {
    max-width: {{ section.settings.iconic_page_width }}px;
  }
  #iconic-rotatingbar-curve-{{ section.id }} {
    margin-top: {{ section.settings.margin_top | times: 0.75 | round: 0 }}px;
    margin-bottom: {{ section.settings.margin_bottom | times: 0.75 | round: 0 }}px;
  }
  #iconic-rotatingbar-curve-{{ section.id }} .iconic-curve-rotating-bar-section {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  #iconic-rotatingbar-curve-{{ section.id }} .iconic-curve-rotating-bar-section {
    background: {{ section.settings.background_color }};
    {% if section.settings.background_gradient != empty %}
      background: {{ section.settings.background_gradient }};
    {% endif %}
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    {% if section.settings.enable_fullwidth == false %}
      border: {{ section.settings.section_border_thickness }}px solid {{ section.settings.section_border_color }};
      border-radius: {{ section.settings.section_corner_radius }}px;
      {% if section.settings.enable_box_shadow %}
        box-shadow: {{ horizontal_offset }}px {{ vertical_offset }}px {{ blur_radius }}px {{ shadow_spread }}px rgba({{ shadow_color }}, {{ shadow_opacity }});
      {% endif %}
    {% endif %}
  }
  {% if section.settings.enable_font == true %}
    {{- section.settings.heading_font | font_face: font_display: 'swap' -}}
    .iconic-rotating-bar-section-{{ section.id }} h1,
    .iconic-rotating-bar-section-{{ section.id }} h2,
    .iconic-rotating-bar-section-{{ section.id }} h3,
    .iconic-rotating-bar-section-{{ section.id }} h4,
    .iconic-rotating-bar-section-{{ section.id }} h5,
    .iconic-rotating-bar-section-{{ section.id }} h6 {
      font-family: {{ section.settings.heading_font.family }};
      font-weight: {{ section.settings.heading_font.weight }};
    }
    {{- section.settings.body_font | font_face: font_display: 'swap' -}}
    .iconic-rotating-bar-section-{{ section.id }} *:not(h1):not(h2):not(h3):not(h4):not(h5):not(h6) {
      font-family: {{ section.settings.body_font.family }};
      font-weight: {{ section.settings.body_font.weight }};
    }
    {% endif %}
  #iconic-rotatingbar-curve-{{ section.id }} .iconic-scrolling-line path {
    stroke: {{ section.settings.text_background_color }};
    stroke-width: {{ section.settings.mobile_height }}px;
  }
  #iconic-rotatingbar-curve-{{ section.id }} .iconic-scrolling-line text {
    font-size: {{ section.settings.mobile_range }}px;
    text-transform: {{ section.settings.title_style }};
  }

  #iconic-rotatingbar-curve-{{ section.id }} .iconic-curve-rotatingbar-title,
  #iconic-rotatingbar-curve-{{ section.id }} .iconic-curve-rotatingbar-title * {
    color: {{ section.settings.title_color }};
    word-break: break-word;
  }
  #iconic-rotatingbar-curve-{{ section.id }} .iconic-curve-rotatingbar-subtitle p {
    font-size: {{ section.settings.subtitle_mobile_font_size }}px;
    line-height: {{ section.settings.subtitle_mobile_line_height }}px;
  }
  #iconic-rotatingbar-curve-{{ section.id }} .iconic-curve-rotatingbar-subtitle * {
    color: {{ section.settings.subtitle_color }};
    margin: 0;
    word-break: break-word;
  }
  #iconic-rotatingbar-curve-{{ section.id }} .iconic-scrolling-line {
    {% assign barheight = section.settings.mobile_height %}
    {% if barheight > 0 %}
      height: calc(123px + {{ barheight }}px);
    {% endif %}
  }
  #iconic-rotatingbar-curve-{{ section.id }} .iconic-scrolling-line {
    width: 300vw;
  }
  @media only screen and (min-width: 768px){
    #iconic-rotatingbar-curve-{{ section.id }} .iconic-scrolling-line {
      width: 100%;
    }
    #iconic-rotatingbar-curve-{{ section.id }} {
      margin-top: {{ section.settings.margin_top }}px;
      margin-bottom: {{ section.settings.margin_bottom }}px;
    }
    #iconic-rotatingbar-curve-{{ section.id }} .iconic-curve-rotatingbar-subtitle p {
      font-size: {{ section.settings.subtitle_desktop_font_size }}px;
      line-height: {{ section.settings.subtitle_desktop_line_height }}px;
    }
    #iconic-rotatingbar-curve-{{ section.id }} .iconic-scrolling-line {
      {% assign barheight = section.settings.desktop_height %}
      {% if barheight > 0 %}
        height: calc(123px + {{ barheight }}px);
      {% endif %}
    }
    #iconic-rotatingbar-curve-{{ section.id }} .iconic-scrolling-line text {
      font-size: {{ section.settings.desktop_range }}px;
    }
    #iconic-rotatingbar-curve-{{ section.id }} .iconic-scrolling-line path {
      stroke-width: {{ section.settings.desktop_height }}px;
    }
  }
{% endstyle %}

{% capture rotating_items %}
  <tspan alignment-baseline="central">
    {% for block in section.blocks %}
      {% if block.settings.icon_text == 'icon-circle' %}
        ● {{ block.settings.heading }}
      {% elsif block.settings.icon_text == 'icon-heart'  %}
        ❤ {{ block.settings.heading }}
      {% elsif block.settings.icon_text == 'icon-tringle' %}
        ▼ {{ block.settings.heading }}
      {% endif %}
    {% endfor %}              
    {% for block in section.blocks %}
      {% if block.settings.icon_text == 'icon-circle' %}
        ● {{ block.settings.heading }}
      {% elsif block.settings.icon_text == 'icon-heart'  %}
        ❤ {{ block.settings.heading }}
      {% elsif block.settings.icon_text == 'icon-tringle' %}
        ▼ {{ block.settings.heading }}
      {% endif %}
    {% endfor %}              
    {% for block in section.blocks %}
      {% if block.settings.icon_text == 'icon-circle' %}
        ● {{ block.settings.heading }}
      {% elsif block.settings.icon_text == 'icon-heart'  %}
        ❤ {{ block.settings.heading }}
      {% elsif block.settings.icon_text == 'icon-tringle' %}
        ▼ {{ block.settings.heading }}
      {% endif %}
    {% endfor %}              
  </tspan>
{% endcapture %}

<iconic-curve-rotating-bar
  id="iconic-rotatingbar-curve-{{ section.id }}"
  data-rotate-enabled="{{ section.settings.rotate_bar }}"
  class="iconic-section{% if request.design_mode and section.settings.animation %} iconic-fade-in{% endif %}"
  {% if section.settings.animation %}
    data-iconic-fade-in
  {% endif %}
  data-iconic-id="6"
  data-iconic-section-id="cd8c06e21bc285e4ba6116f0d320729669dfaeb0e7a5a512d4e1f3a4154a755e"
  data-iconic-secret="{{ shop.metaobjects.app--80752541697--iconic-sections.iconic-sections.secret_key }}"
  style="display: none;"
>
  <div class="{% if section.settings.enable_fullwidth == false %} iconic-px-4{% endif %}">
    <div class="iconic-curve-rotating-bar-section iconic-d-block{% if section.settings.enable_fullwidth %} iconic-container-fluid{% else %} iconic-container{% endif %} iconic-rotating-bar-section-{{ section.id }} iconic-px-0">
      {% if section.settings.title != blank or section.settings.subtitle != blank %}
        <div class="iconic-curve-rotatingbar-title iconic-pb-4 iconic-px-4 iconic-pb-md-5{% if section.settings.heading_width == 'narrow' %} iconic-mw-100 iconic-w-75 iconic-w-lg-50{% endif %}{% if section.settings.heading_alignment == 'center' %} iconic-m-auto{% endif %}{% if section.settings.heading_alignment == 'end' %} iconic-ms-auto{% endif %}">
          {% if section.settings.title != blank %}
            <{{ section.settings.title_size }} class="iconic-curve-title iconic-text-{{ section.settings.title_text_style}} iconic-m-0 iconic-text-{{ section.settings.heading_alignment }}">
              {{ section.settings.title }}
            </{{ section.settings.title_size }}>
          {% endif %}
          {% if section.settings.subtitle != blank %}
            <div class="iconic-curve-rotatingbar-subtitle iconic-mt-2 iconic-text-{{ section.settings.subtitle_text_style }} iconic-text-{{ section.settings.heading_alignment }}">
              {{ section.settings.subtitle }}
            </div>
          {% endif %}
        </div>
      {% endif %}
      <div class="iconic iconic-overflow-hidden">
        <div class="iconic-col-12 iconic-p-0">
          <a
            href="{% if section.settings.text_url != blank %}{{ section.settings.text_url }}{% endif %}"
            target="_blank"
          >
            <svg
              class="iconic-scrolling-line iconic-d-block"
              xmlns="http://www.w3.org/2000/svg"
              width="1440"
              height="123"
              viewBox="0 0 1440 123"
            >
              <path id="wavepath" fill="transparent" stroke-width="64px" d="M0 33V33C24.7671 33 49.3015 37.7803 72.2569 47.0787L117.088 65.2381C192.409 95.7478 276.921 94.1781 351.057 60.8926L360.843 56.4992C436.256 22.6403 522.889 24.4444 596.827 61.4134V61.4134C674.366 100.183 765.634 100.183 843.173 61.4134V61.4134C917.111 24.4444 1003.74 22.6403 1079.16 56.4992L1088.94 60.8926C1163.08 94.1781 1247.59 95.7478 1322.91 65.2381L1367.74 47.0787C1390.7 37.7803 1415.23 33 1440 33V33"></path>
              <text text-anchor="middle" style="fill: {{ section.settings.text_color }}">
                <textPath href="#wavepath" startOffset="0%">
                  <animate attributeName="startOffset"{% if section.settings.animation_direction == 'left' %} from="150%"{% else %} from="0%"{% endif %}{% if section.settings.animation_direction == 'left' %} to="0%"{% else %} to="150%"{% endif %} begin="0s" dur="{{ section.settings.animation_speed | times: 10 }}s" repeatCount="indefinite">
                  </animate>
                  {{ rotating_items }}
                  {{ rotating_items }}
                </textPath>
              </text>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</iconic-curve-rotating-bar>

<script>
  (function () {
    function initRotatingBar() {
      const barId = "iconic-rotatingbar-curve-{{ section.id }}";
      const rotatingBar = document.getElementById(barId);
      if (!rotatingBar) return;

      const animate = rotatingBar.querySelector("animate");
      if (!animate) return;

      let lastScrollTop = window.pageYOffset || document.documentElement.scrollTop;
      let isScrollingDown = false;
      let isScrollingUp = false;

      const onScroll = () => {
        // Check if rotate_bar is still enabled
        if (rotatingBar.dataset.rotateEnabled !== 'true') return;

        const currentScrollTop = window.pageYOffset || document.documentElement.scrollTop;
        const currentFrom = animate.getAttribute("from");

        const reverse = () => {
          animate.setAttribute("from", currentFrom === '150%' ? '0%' : '150%');
          animate.setAttribute("to", currentFrom === '150%' ? '150%' : '0%');
          rotatingBar.offsetHeight; // Force reflow
        };

        if (currentScrollTop > lastScrollTop && !isScrollingDown) {
          reverse();
          isScrollingDown = true;
          isScrollingUp = false;
        } else if (currentScrollTop < lastScrollTop && !isScrollingUp) {
          reverse();
          isScrollingUp = true;
          isScrollingDown = false;
        }

        lastScrollTop = currentScrollTop <= 0 ? 0 : currentScrollTop;
      };

      // Remove old scroll (if any) and re-add
      window.removeEventListener('scroll', window._rotatingBarScrollHandler);
      window._rotatingBarScrollHandler = onScroll;
      window.addEventListener('scroll', onScroll);
    }

    document.addEventListener('DOMContentLoaded', initRotatingBar);

    // Shopify Editor support
    if (Shopify.designMode) {
      document.addEventListener('shopify:section:load', function (e) {
        if (e.target.id === 'shopify-section-{{ section.id }}') {
          initRotatingBar();
        }
      });
    }
  })();
</script>

