<script>
	(() => {
		class VtlsHighlightedText extends HTMLElement {
			get decoEmSelector() {
				return '[data-decoration="decorative-line"] em, [data-decoration="straight-line"] em, [data-decoration="circle"] em';
			}

			connectedCallback() {
				this.reinit();
			}

			disconnectedCallback() {
				clearTimeout(this.mutationDebounce);
				clearTimeout(this.resizeDebounce);
				cancelAnimationFrame(this.rafId);
				this.mutationObserver?.disconnect();
				this.observer?.disconnect();
				this.resizeObserver?.disconnect();
			}

			isDesignMode() {
				return window.Shopify?.designMode || document.documentElement.classList.contains('shopify-design-mode');
			}

			getContentSignature() {
				const ems = this.querySelectorAll('[data-decoration] em');
				return [...ems].map((em) => em.textContent).join('\n');
			}

			reinit() {
				clearTimeout(this.mutationDebounce);
				clearTimeout(this.resizeDebounce);
				cancelAnimationFrame(this.rafId);
				this.mutationObserver?.disconnect();
				this.resizeObserver?.disconnect();
				this.observer?.disconnect();
				this.lastResizeWidth = null;

				this.querySelectorAll('.vtls-deco-line').forEach((line) => {
					while (line.firstChild) line.parentNode.insertBefore(line.firstChild, line);
					line.remove();
				});
				this.querySelectorAll('.vtls-deco-word').forEach((word) => {
					while (word.firstChild) word.parentNode.insertBefore(word.firstChild, word);
					word.remove();
				});
				this.querySelectorAll(this.decoEmSelector).forEach((em) => em.normalize());

				this.wrapEmWords();

				const isDesign = this.isDesignMode();

				this.rafId = requestAnimationFrame(() => {
					this.groupWordsByLine(isDesign);
					this.initObserver();
					this.initResizeObserver();
					if (isDesign) {
						this.lastContentSignature = this.getContentSignature();
						this.startMutationObserver();
					}
				});
			}

			allDecoSpansIntact() {
				const ems = this.querySelectorAll(this.decoEmSelector);
				for (const em of ems) {
					if (!em.querySelector('.vtls-deco-line')) return false;
				}
				return true;
			}

			startMutationObserver() {
				this.mutationObserver?.disconnect();
				this.mutationObserver = new MutationObserver(() => {
					clearTimeout(this.mutationDebounce);
					this.mutationDebounce = setTimeout(() => {
						if (this.allDecoSpansIntact() && this.getContentSignature() === this.lastContentSignature) return;
						this.reinit();
					}, 50);
				});
				this.mutationObserver.observe(this, { childList: true, subtree: true, characterData: true });
			}

			wrapEmWords() {
				[...this.querySelectorAll(this.decoEmSelector)].forEach((em) => {
					if (em.querySelector('.vtls-deco-word')) return;

					const walker = document.createTreeWalker(em, NodeFilter.SHOW_TEXT);
					const textNodes = [];
					let node;
					while ((node = walker.nextNode())) {
						textNodes.push(node);
					}

					textNodes.forEach((textNode) => {
						const fragment = document.createDocumentFragment();
						textNode.textContent.split(/(\s+)/).forEach((part) => {
							if (!part) return;
							if (/^\s+$/.test(part)) {
								fragment.appendChild(document.createTextNode(part));
							} else {
								const span = document.createElement('span');
								span.className = 'vtls-deco-word';
								span.textContent = part;
								fragment.appendChild(span);
							}
						});
						textNode.parentNode.replaceChild(fragment, textNode);
					});
				});
			}

			groupEmByLine(em, instant = false) {
				const words = [...em.querySelectorAll('.vtls-deco-word')];
				if (!words.length) return;

				const rawTops = words.map((w) => w.getBoundingClientRect().top);

				const lineBuckets = [];
				rawTops.forEach((top) => {
					if (!lineBuckets.find((b) => Math.abs(b - top) < 4)) lineBuckets.push(top);
				});

				if (!lineBuckets.length) return;

				const wordKeys = rawTops.map((top) => lineBuckets.find((b) => Math.abs(b - top) < 4));

				const groups = new Map();
				lineBuckets.forEach((b) => groups.set(b, []));

				const wordToKey = new Map();
				words.forEach((w, i) => wordToKey.set(w, wordKeys[i]));

				let currentKey = wordKeys[0];

				[...em.childNodes].forEach((node) => {
					let key;
					if (node.nodeType === Node.ELEMENT_NODE) {
						if (node.classList?.contains('vtls-deco-word')) {
							key = wordToKey.get(node);
						} else {
							const firstWord = node.querySelector?.('.vtls-deco-word');
							if (firstWord) key = wordToKey.get(firstWord);
						}
					}
					if (key != null) currentKey = key;
					groups.get(currentKey)?.push(node);
				});

				while (em.firstChild) em.removeChild(em.firstChild);

				const lineEntries = [...groups.entries()];
				lineEntries.forEach(([, nodes], idx) => {
					while (nodes.length && nodes[nodes.length - 1].nodeType === Node.TEXT_NODE && /^\s+$/.test(nodes[nodes.length - 1].textContent)) {
						nodes.pop();
					}

					const lineSpan = document.createElement('span');
					lineSpan.className = instant ? 'vtls-deco-line vtls-deco-line--instant' : 'vtls-deco-line';
					nodes.forEach((n) => lineSpan.appendChild(n));
					em.appendChild(lineSpan);

					if (idx < lineEntries.length - 1) {
						em.appendChild(document.createTextNode(' '));
					}
				});
			}

			groupWordsByLine(instant = false) {
				this.querySelectorAll(this.decoEmSelector).forEach((em) => this.groupEmByLine(em, instant));
			}

			regroupLines() {
				this.querySelectorAll(this.decoEmSelector).forEach((em) => {
					const parent = em.closest('[data-decoration]');
					const decoType = parent?.dataset.decoration;
					const decorationClass = decoType ? [...parent.classList].find((cls) => cls.includes(`--decoration-${decoType}`)) : null;
					const isVisible = decorationClass ? parent.classList.contains(`${decorationClass}--VtlsVisible`) : false;

					em.querySelectorAll('.vtls-deco-line').forEach((line) => {
						while (line.firstChild) line.parentNode.insertBefore(line.firstChild, line);
						line.remove();
					});
					em.normalize();

					this.groupEmByLine(em, isVisible || this.isDesignMode());
				});
			}

			initResizeObserver() {
				this.resizeObserver = new ResizeObserver((entries) => {
					const width = Math.round(entries[0].contentRect.width);
					if (this.lastResizeWidth == null) {
						this.lastResizeWidth = width;
						return;
					}
					if (this.lastResizeWidth === width) return;
					this.lastResizeWidth = width;
					clearTimeout(this.resizeDebounce);
					this.resizeDebounce = setTimeout(() => this.regroupLines(), 50);
				});
				this.resizeObserver.observe(this);
			}

			initObserver() {
				const elements = this.querySelectorAll(
					'[data-decoration="decorative-line"], [data-decoration="circle"], [data-decoration="straight-line"]'
				);
				if (!elements.length) return;

				if (this.isDesignMode()) {
					elements.forEach((el) => {
						const decorationClass = [...el.classList].find((cls) => cls.includes(`--decoration-${el.dataset.decoration}`));
						if (decorationClass) el.classList.add(`${decorationClass}--VtlsVisible`);
					});
					return;
				}

				this.observer = new IntersectionObserver(
					(entries) => {
						entries.forEach((entry) => {
							if (!entry.isIntersecting) return;
							const decorationClass = [...entry.target.classList].find((cls) =>
								cls.includes(`--decoration-${entry.target.dataset.decoration}`)
							);
							if (decorationClass) entry.target.classList.add(`${decorationClass}--VtlsVisible`);
							this.observer.unobserve(entry.target);
						});
					},
					{ threshold: 0.5 }
				);

				elements.forEach((el) => this.observer.observe(el));
			}
		}

		const register = () => {
			if (!customElements.get('vtls-highlighted-text')) {
				customElements.define('vtls-highlighted-text', VtlsHighlightedText);
			}
		};

		document.addEventListener('shopify:section:load', () => {
			register();
		});

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', register);
		} else {
			register();
		}
	})();
</script>

<script>
	(function () {
		const uninstallMessage = 'Displaying this section requires an active Square: Theme Sections & AI Pages subscription. Reinstall the <a href="https://apps.shopify.com/theme-sections-ai-page-builder" target="_blank">Square: Theme Sections & AI Pages app</a> to activate it or consider removing the section.';
		const downgradeMessage = 'You downgraded to a free plan. You need to upgrade your <a href="https://apps.shopify.com/theme-sections-ai-page-builder" target="_blank">Square: Theme Sections & AI Pages app</a> plan to activate it or consider removing the section.';
		const projectId = '5';
		const sectionsSelector = '.shopify-section';
		const apps = {
			'1': {
				prefix: 'vitals',
				hostname: 'https://appsolve.io'
			},
			'5': {
				prefix: 'tsapb',
				hostname: 'https://theme-sections.sqa-api.com'
			}
		};

		const cacheKeysMetaFields = '{{ shop.metafields.vitals.tsck }}';
		const shopId = '{{ shop.id }}';

		const getHostname = () => {
			if (apps[projectId].hostname) {
				return apps[projectId].hostname;
			}

			console.error(`hostname for appId ${projectId} cannot be determined.`);
			return undefined;
		}

		const disableSection = (message, selector) => {
			const mainContainer = document.querySelector(selector);
			const contentContainer = document.querySelector(`${selector} > section`);

			if ('{{ request.design_mode }}' === 'true') {
				contentContainer.innerHTML = `<h2 class="VtlsUninstallBG"><div class="VtlsUninstallBG__Text">${message}</div></h2>`;
			} else {
				mainContainer.style.display = 'none';
				mainContainer.remove();
			}
		};

		const getThemeSectionIdsByUUID = (installedThemeSections, uuid, appId) => {
			const listIds = [];

			installedThemeSections.forEach((installedThemeSection) => {
				if (installedThemeSection.id.includes(`${apps[appId].prefix}_${uuid}`)) {
					listIds.push(installedThemeSection.id);
				}
			})

			return listIds;
		}

		const getThemeSectionsStatusList = (url) => fetch(url, {
			method: 'GET',
			headers: { 'Content-Type': 'application/json' },
		}).then((response) => response.json());

		const evaluateThemeSections = (url) => {
			getThemeSectionsStatusList(url).then(response => {
				const { data, f, i } = response;
				const installedThemeSections = document.querySelectorAll(sectionsSelector);

				data.forEach((themeSection) => {
					const { e, u, a } = themeSection;

					if (!e) {
						const themeSectionsWithUUID = getThemeSectionIdsByUUID(installedThemeSections, u, a);
						let message = '';

						if (f) {
							message = downgradeMessage;
						}

						if (!i) {
							message = uninstallMessage;
						}

						themeSectionsWithUUID.forEach((themeSectionSelector) => {
							disableSection(message, `#${themeSectionSelector}`);
						})
					}
				});
			})
		}

		if (shopId) {
			if (window.vtlsSecurityCheckStarted === undefined) {
				window.vtlsSecurityCheckStarted = true;

				let url = '';
				const hostname = getHostname();

				if (!hostname) {
					return;
				}

				const baseUrl = `${hostname}/bundle/api/v2/sf/ts`;

				if (cacheKeysMetaFields) {
					url = `${baseUrl}/${shopId}/${cacheKeysMetaFields}.json`;
				} else {
					const timestamp = Math.round(new Date().getTime() / 1000 / 10000) * 10000;
					url = `${baseUrl}/${shopId}/${timestamp}.json`;
				}

				evaluateThemeSections(url);
			}
		}
	})();
</script>

