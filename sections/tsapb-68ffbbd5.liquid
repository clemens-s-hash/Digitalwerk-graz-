--vtl-color-border-default-on-light: var(--vtl-neutral-100);
--vtl-space-2: var(--vtl-size-2);
--vtl-space-4: var(--vtl-size-4);
--vtl-space-8: var(--vtl-size-8);
--vtl-space-12: var(--vtl-size-12);
--vtl-space-16: var(--vtl-size-16);
--vtl-space-20: var(--vtl-size-20);
--vtl-space-24: var(--vtl-size-24);
--vtl-space-32: var(--vtl-size-32);
--vtl-space-40: var(--vtl-size-40);
--vtl-space-64: var(--vtl-size-64);
--vtl-font-size-14: var(--vtl-size-14);
}


{% endstyle %}

<!-- --UUID-68ffbbd5-- -->

{%- liquid
	assign content_alignment_effective = section.settings.content_alignment
	assign loading = "lazy"
	assign fetchpriority = "auto"
	assign preload = false
	assign background_sizes = "100vw"
	if section.settings.content_layout_desktop == "horizontal"
		assign content_alignment_effective = section.settings.content_alignment_horizontal
	endif

	assign section_height_padding = 56
	if section.settings.section_height == "small"
		assign section_height_padding = 32
	elsif section.settings.section_height == "large"
		assign section_height_padding = 100
	endif

	if section.index == 1
		assign loading = "eager"
		assign fetchpriority = "high"
		assign preload = true
	endif

	assign button_block = section.blocks | where: "type", "button" | first
	assign has_left_content = false
	assign has_right_content = false
	for block in section.blocks
		case block.type
			when "heading"
				if block.settings.heading != blank
					assign has_left_content = true
				endif
			when "text"
				if block.settings.description != blank
					assign has_right_content = true
				endif
		endcase
	endfor
-%}

<section class="Vtls-{{ section.id | handle }} VtlsHighlightedText">
		<div
			class="
				VtlsHighlightedTextContainer
				VtlsHighlightedTextContainer--backgroundStyle-{{ section.settings.section_background_style }}
				{% if section.settings.section_background_style == "gradient" and section.settings.enable_animation == true %}VtlsHighlightedTextContainer--hasAnimation{% endif %}
				{% if section.settings.section_background_style == 'border' %}VtlsHighlightedTextContainer--hasBorder{% endif %}
			"
		>
			{%- if section.settings.section_background_style == "image" -%}
				<div class="VtlsHighlightedTextContainer__BackgroundMedia" aria-hidden="true">
					{%- if section.settings.background_image != blank -%}
						{{-
							section.settings.background_image
							| image_url: width: section.settings.background_image.width
							| image_tag:
								class: "VtlsHighlightedTextContainer__BackgroundImage",
								sizes: background_sizes,
								widths: "400, 600, 800, 1200, 1600, 1800, 2400, 2800, 3200",
								loading: loading,
								fetchpriority: fetchpriority,
								preload: preload
						-}}
					{%- else -%}
						<img
							src="data:image/webp;base64,"
							alt="Placeholder"
							width="1440"
							height="800"
							class="VtlsHighlightedTextContainer__BackgroundImage"
						>
					{%- endif -%}
					<div class="VtlsHighlightedTextContainer__BackgroundOverlay"></div>
				</div>
			{%- endif -%}
		<vtls-highlighted-text
				class="
					VtlsHighlightedTextContent
				VtlsHighlightedTextContent--contentLayout-{{ section.settings.content_layout_desktop }}
				VtlsHighlightedTextContent--alignment-{{ content_alignment_effective }}
				{% unless has_right_content %}VtlsHighlightedTextContent--noRightContent{% endunless %}
			"
		>
			{%- if has_left_content -%}
				<div class="VtlsTextBox VtlsTextBox--left">
					{%- for block in section.blocks -%}
						{%- case block.type -%}
							{%- when "heading" -%}
								{%- if block.settings.heading != blank -%}
									{%- if block.settings.heading_alternative_font -%}
										<style>
											{{- block.settings.heading_font | font_face: font_display: 'swap' -}}
										</style>
									{%- endif -%}
									{%- if block.settings.heading_type == "alternative_font" -%}
										<style>
											{{- block.settings.heading_decoration_font | font_face: font_display: 'swap' -}}
										</style>
									{%- endif -%}
									{%- capture heading_css_variables -%}
											--block-heading-size: {{- block.settings.heading_size -}}px;
											--block-heading-color: {{- block.settings.heading_color -}};
											--block-heading-font: {{- block.settings.heading_font.family -}};
											--block-heading-decoration-color: {{- block.settings.heading_decoration_color -}};	
											--block-heading-decoration-gradient: {{- block.settings.heading_decoration_gradient -}};
											--block-heading-decoration-background-color: {{- block.settings.heading_decoration_background_color -}};
											--block-heading-decoration-background-gradient: {{- block.settings.heading_decoration_background_gradient -}};
											--block-heading-decoration-font: {{- block.settings.heading_decoration_font.family -}};
											--heading-decorative-line-move: {{- block.settings.heading_decorative_line_move -}}px;                              
									{%- endcapture -%}
									<h2
										style="{{- heading_css_variables | strip_newlines | escape -}}"
										class="
											VtlsTextBox__Heading
											VtlsTextBox__Heading--style-{{ block.settings.heading_style }}
											{% if block.settings.heading_alternative_font == true %}VtlsTextBox__Heading--alternativeFont{% endif %}
											VtlsTextBox__Heading--decoration-{{ block.settings.heading_type }} VtlsTextBox__Heading--decoration-background-{{ block.settings.heading_decoration_background_type }}
										"
										data-decoration="{{ block.settings.heading_type }}"
										{{ block.shopify_attributes }}
									>
										{{- block.settings.heading -}}
									</h2>
								{%- endif -%}
						{%- endcase -%}
					{%- endfor -%}
				</div>
			{%- endif -%}
			{%- if has_right_content -%}
				<div class="VtlsTextBox VtlsTextBox--right">
					{%- for block in section.blocks -%}
						{%- case block.type -%}
							{%- when "text" -%}
								{%- if block.settings.description != blank -%}
									{%- if block.settings.description_alternative_font -%}
										{%- liquid
											assign body_font_bold = block.settings.description_font | font_modify: "weight", "bold"
											assign body_font_italic = block.settings.description_font | font_modify: "style", "italic"
											assign body_font_bold_italic = body_font_bold | font_modify: "style", "italic"
										%}
										<style>
											{{- block.settings.description_font | font_face: font_display: 'swap' -}}
											{{ body_font_bold | font_face: font_display: 'swap' }}
											{{ body_font_italic | font_face: font_display: 'swap' }}
											{{ body_font_bold_italic | font_face: font_display: 'swap' }}
										</style>
									{%- endif -%}
									{%- if block.settings.description_type == "alternative_font" -%}
										<style>
											{{- block.settings.description_decoration_font | font_face: font_display: 'swap' -}}
										</style>
									{%- endif -%}
									{%- capture description_css_variables -%}
											--block-description-size: {{- block.settings.description_size -}}px;
											--block-description-color: {{- block.settings.description_color -}};
											--block-description-font: {{- block.settings.description_font.family -}};
											--block-description-decoration-color: {{- block.settings.description_decoration_color -}};
											--block-description-decoration-gradient: {{- block.settings.description_decoration_gradient -}};
											--block-description-decoration-background-color: {{- block.settings.description_decoration_background_color -}};
											--block-description-decoration-background-gradient: {{- block.settings.description_decoration_background_gradient -}};
											--block-description-decoration-font: {{- block.settings.description_decoration_font.family -}};
											--description-decorative-line-move: {{- block.settings.description_decorative_line_move -}}px;                                
									{%- endcapture -%}
									<div
										style="{{- description_css_variables | strip_newlines | escape -}}"
										class="
											VtlsTextBox__Description
											VtlsTextBox__Description--alignment-{{ content_alignment_effective }}
											{% if block.settings.description_alternative_font == true %}VtlsTextBox__Description--alternativeFont{% endif %}
											VtlsTextBox__Description--decoration-{{ block.settings.description_type }} VtlsTextBox__Description--decoration-background-{{ block.settings.description_decoration_background_type }}
										"
										data-decoration="{{ block.settings.description_type }}"
										{{ block.shopify_attributes }}
									>
										{{- block.settings.description -}}
									</div>
								{%- endif -%}
						{%- endcase -%}
					{%- endfor -%}
				</div>
			{%- endif -%}
			{%- if button_block -%}
				{%- capture button_css_variables -%}
							--block-primary-button-text-color: {{- button_block.settings.primary_text_color -}};
							--block-primary-button-background-color: {{- button_block.settings.primary_background_color -}};
							--block-primary-button-corner-radius: {{- button_block.settings.primary_button_corner -}}px;
							--block-primary-button-border-color: {{- button_block.settings.primary_border_color -}};
					{%- endcapture -%}
				{%- if button_block.settings.primary_button_label != blank -%}
					<div
						style="{{- button_css_variables | strip_newlines | escape -}}"
						class="VtlsHighlightedTextButton"
						{{ button_block.shopify_attributes }}
					>
						<a
							{% if button_block.settings.primary_new_tab == true %}
								target="_blank"
								rel="noopener noreferrer"
							{% endif %}
							class="VtlsHighlightedTextButton__Primary VtlsHighlightedTextButton__Primary--{{ button_block.settings.primary_button_style }}"
							href="{{ button_block.settings.primary_button_link | default: '#' }}"
						>
							{{- button_block.settings.primary_button_label | escape -}}
						</a>
					</div>
				{%- endif -%}
			{%- endif -%}
		</vtls-highlighted-text>
	</div>
</section>

{% schema %}
{
	"name": "❤️ Highlighted Text",
	"disabled_on": {
		"groups": ["header"]
	},
	"settings": [
		{
			"type": "header",
			"content": "General"
		},
		{
			"type": "select",
			"id": "content_layout_desktop",
			"label": "Content layout on desktop",
			"options": [
				{
					"value": "vertical",
					"label": "Vertical"
				},
				{
					"value": "horizontal",
					"label": "Horizontal"
				}
			],
			"default": "vertical"
		},
		{
			"type": "select",
			"id": "content_alignment",
			"label": "Content alignment",
			"options": [
				{
					"value": "left",
					"label": "Left"
				},
				{
					"value": "center",
					"label": "Center"
				},
				{
					"value": "right",
					"label": "Right"
				}
			],
			"default": "center",
			"visible_if": "{{ section.settings.content_layout_desktop == 'vertical' }}"
		},
		{
			"type": "select",
			"id": "content_alignment_horizontal",
			"label": "Content alignment",
			"options": [
				{
					"value": "left",
					"label": "Left"
				},
				{
					"value": "right",
					"label": "Right"
				}
			],
			"default": "left",
			"visible_if": "{{ section.settings.content_layout_desktop == 'horizontal' }}"
		},
		{
			"type": "range",
			"id": "heading_text_box_width_horizontal",
			"min": 30,
			"max": 70,
			"step": 1,
			"unit": "%",
			"label": "Heading block width",
			"visible_if": "{{ section.settings.content_layout_desktop == 'horizontal' }}",
			"default": 50
		},
		{
			"type": "select",
			"id": "section_height",
			"label": "Section height",
			"options": [
				{
					"value": "small",
					"label": "Small"
				},
				{
					"value": "medium",
					"label": "Medium"
				},
				{
					"value": "large",
					"label": "Large"
				}
			],
			"default": "medium"
		},
		{
			"type": "header",
			"content": "Design"
		},
		{
			"type": "select",
			"id": "section_background_style",
			"label": "Section background",
			"options": [
				{
					"value": "regular",
					"label": "Color"
				},
				{
					"value": "gradient",
					"label": "Gradient"
				},
				{
					"value": "image",
					"label": "Image"
				},
				{
					"value": "border",
					"label": "Border"
				}
			],
			"default": "regular"
		},
		{
			"type": "color",
			"id": "section_background",
			"label": "Background color",
			"default": "#F8F8F8",
			"visible_if": "{{ section.settings.section_background_style == 'regular' }}"
		},
		{
			"type": "color_background",
			"id": "section_gradient",
			"label": "Background gradient",
			"default": "linear-gradient(#72ffb3, #fffa63)",
			"visible_if": "{{ section.settings.section_background_style == 'gradient' }}"
		},
		{
			"type": "checkbox",
			"id": "enable_animation",
			"label": "Apply animation",
			"default": false,
			"visible_if": "{{ section.settings.section_background_style == 'gradient' }}"
		},
		{
			"type": "image_picker",
			"id": "background_image",
			"label": "Background image",
			"visible_if": "{{ section.settings.section_background_style == 'image' }}"
		},
		{
			"type": "color",
			"id": "overlay_color",
			"label": "Background overlay color",
			"default": "#222222",
			"visible_if": "{{ section.settings.section_background_style == 'image' }}"
		},
		{
			"type": "range",
			"id": "overlay_opacity",
			"min": 0,
			"max": 100,
			"step": 2,
			"unit": "%",
			"label": "Background overlay opacity",
			"visible_if": "{{ section.settings.section_background_style == 'image' }}",
			"default": 0
		},
		{
			"type": "color",
			"id": "border_color",
			"label": "Border color",
			"visible_if": "{{ section.settings.section_background_style == 'border' }}",
			"default": "#222222"
		},
		{
			"type": "range",
			"id": "section_corner_radius",
			"label": "Section corner radius",
			"min": 0,
			"max": 80,
			"step": 2,
			"unit": "px",
			"default": 0
		},
		{
			"type": "header",
			"content": "Layout"
		},
		{
			"type": "select",
			"id": "layout_type",
			"label": "Layout type",
			"options": [
				{
					"value": "desktop",
					"label": "Desktop"
				},
				{
					"value": "mobile",
					"label": "Mobile"
				}
			],
			"default": "desktop"
		},
		{
			"type": "range",
			"id": "section_width_desktop",
			"min": 70,
			"max": 100,
			"step": 1,
			"unit": "%",
			"label": "Section width",
			"visible_if": "{{ section.settings.layout_type == 'desktop' }}",
			"default": 80
		},
		{
			"type": "text",
			"id": "section_max_width",
			"label": "Custom max width (optional)",
			"visible_if": "{{ section.settings.layout_type == 'desktop' }}",
			"info": "Section max width in pixels"
		},
		{
			"type": "range",
			"id": "section_width_mobile",
			"min": 70,
			"max": 100,
			"step": 1,
			"unit": "%",
			"visible_if": "{{ section.settings.layout_type == 'mobile' }}",
			"label": "Section width",
			"default": 80
		},
		{
			"type": "range",
			"id": "margin_top_desktop",
			"min": 0,
			"max": 100,
			"step": 2,
			"unit": "px",
			"visible_if": "{{ section.settings.layout_type == 'desktop' }}",
			"label": "Margin top",
			"default": 40
		},
		{
			"type": "range",
			"id": "margin_bottom_desktop",
			"min": 0,
			"max": 100,
			"step": 2,
			"unit": "px",
			"visible_if": "{{ section.settings.layout_type == 'desktop' }}",
			"label": "Margin bottom",
			"default": 40
		},
		{
			"type": "range",
			"id": "margin_top_mobile",
			"min": 0,
			"max": 100,
			"step": 2,
			"unit": "px",
			"visible_if": "{{ section.settings.layout_type == 'mobile' }}",
			"label": "Margin top",
			"default": 20
		},
		{
			"type": "range",
			"id": "margin_bottom_mobile",
			"min": 0,
			"max": 100,
			"step": 2,
			"unit": "px",
			"visible_if": "{{ section.settings.layout_type == 'mobile' }}",
			"label": "Margin bottom",
			"default": 20
		},
		{
			"type": "header",
			"content": "Advanced"
		},
		{
			"type": "product",
			"id": "product",
			"label": "Product",
			"info": "Select a product to access its metafields and use them in this section on any page."
