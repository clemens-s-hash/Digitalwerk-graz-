					"options": [
						{
							"value": "color",
							"label": "Color"
						},
						{
							"value": "gradient",
							"label": "Gradient"
						}
					],
					"default": "gradient"
				},
				{
					"type": "color",
					"id": "heading_decoration_color",
					"label": "Decoration color",
					"default": "#FFCE07",
					"visible_if": "{{ block.settings.heading_type != 'gradient' and block.settings.heading_type != 'alternative_font' and block.settings.heading_type != 'background' }}"
				},
				{
					"type": "color",
					"id": "heading_decoration_background_color",
					"label": "Color",
					"default": "#FFCE07",
					"visible_if": "{{ block.settings.heading_decoration_background_type == 'color' and block.settings.heading_type == 'background' }}"
				},
				{
					"type": "color_background",
					"id": "heading_decoration_background_gradient",
					"label": "Gradient",
					"default": "linear-gradient(90deg, #FFE431, #F9C420 100%)",
					"visible_if": "{{ block.settings.heading_decoration_background_type == 'gradient' and block.settings.heading_type == 'background' }}"
				},
				{
					"type": "color_background",
					"id": "heading_decoration_gradient",
					"label": "Decoration gradient",
					"default": "linear-gradient(180deg, #FFE431, #F92020 100%)",
					"visible_if": "{{ block.settings.heading_type == 'gradient' }}"
				},
				{
					"type": "font_picker",
					"id": "heading_decoration_font",
					"label": "Decoration font",
