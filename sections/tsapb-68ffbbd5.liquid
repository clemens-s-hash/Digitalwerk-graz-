					"visible_if": "{{ block.settings.heading_type == 'decorative-line' or block.settings.heading_type == 'straight-line' }}",
					"default": 6
				},
				{
					"type": "range",
					"id": "heading_size",
					"label": "Heading size",
					"min": 24,
					"max": 68,
					"step": 2,
					"unit": "px",
					"default": 36
				},
				{
					"type": "select",
					"id": "heading_style",
					"label": "Heading style",
					"options": [
						{
							"value": "regular",
							"label": "Regular"
						},
						{
							"value": "bold",
							"label": "Bold"
						}
					],
					"default": "regular"
				},
				{
					"type": "color",
