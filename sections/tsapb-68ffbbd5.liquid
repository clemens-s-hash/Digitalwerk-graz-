				},
				{
					"type": "richtext",
					"id": "heading",
					"default": "<p>A dedicated <em>highlight</em> for your key <em>promotional</em> message</p>",
					"label": "Heading"
				},
				{
					"type": "select",
					"id": "heading_type",
					"label": "Decoration",
					"options": [
						{
							"value": "color",
							"label": "Color"
						},
						{
							"value": "gradient",
							"label": "Gradient"
						},
						{
							"value": "alternative_font",
							"label": "Alternative font"
						},
						{
							"value": "background",
							"label": "Background"
						},
						{
							"value": "straight-line",
							"label": "Underline"
						},
						{
							"value": "decorative-line",
