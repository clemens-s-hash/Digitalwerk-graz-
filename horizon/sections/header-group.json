{
  "type": "header",
  "name": "t:names.header",
  "sections": {
    "announcement_bar": {
      "type": "header-announcements",
      "blocks": {
        "announcement_versand": {
          "type": "_announcement",
          "settings": {
            "text": "Kostenloser DHL-Versand inkl. Sendungsverfolgung",
            "font": "var(--font-body--family)",
            "font_size": "0.75rem",
            "weight": "500",
            "letter_spacing": "loose",
            "case": "uppercase"
          }
        }
      },
      "block_order": ["announcement_versand"],
      "name": "Ankündigungsleiste",
      "settings": {
        "speed": 5,
        "section_width": "full-width",
        "background_color": "#1C1A17",
        "divider_width": 0,
        "padding-block-start": 10,
        "padding-block-end": 10
      }
    },
    "ticker": {
      "type": "marquee",
      "disabled": true,
      "blocks": {
        "ticker_1": {
          "type": "text",
          "settings": {
            "text": "<p>WELCOME!</p>",
            "type_preset": "h4",
            "width": "fit-content",
            "alignment": "center"
          }
        },
        "ticker_2": {
          "type": "text",
          "settings": {
            "text": "<p>SITEWIDE SALE</p>",
            "type_preset": "h4",
            "width": "fit-content",
            "alignment": "center"
          }
        },
        "ticker_3": {
          "type": "text",
          "settings": {
            "text": "<p>USE CODE X FOR X% OFF!</p>",
            "type_preset": "h4",
            "width": "fit-content",
            "alignment": "center"
          }
        }
      },
      "block_order": ["ticker_1", "ticker_2", "ticker_3"],
      "name": "Lauftext",
      "settings": {
        "movement_direction": "normal",
        "background_color": "#1C1A17",
        "gap_between_elements": 30,
        "padding-block-start": 16,
        "padding-block-end": 16
      }
    },
    "header_section": {
      "type": "header",
      "blocks": {
        "header-logo": {
          "type": "_header-logo",
          "static": true,
          "settings": {
            "hide_logo_on_home_page": false,
            "padding-block-start": 0,
            "padding-block-end": 0
          }
        },
        "header-menu": {
          "type": "_header-menu",
          "static": true,
          "settings": {
            "menu": "main-menu",
            "type_font_primary_size": "0.75rem",
            "type_font_primary_link": "body",
            "type_case_primary_link": "uppercase",
            "menu_font_style": "regular",
            "menu_style": "text",
            "image_border_radius": 0,
            "navigation_bar": false,
            "drawer_accordion": true,
            "drawer_accordion_expand_first": false,
            "drawer_dividers": true
          }
        }
      },
      "name": "Kopfbereich",
      "settings": {
        "logo_position": "left",
        "menu_position": "center",
        "menu_row": "top",
        "show_search": true,
        "search_position": "right",
        "search_row": "top",
        "show_country": false,
        "show_language": true,
        "section_width": "page-width",
        "section_height": "standard",
        "enable_sticky_header": "always",
        "divider_width": 0,
        "border_width": 1,
        "background_color_top": "{{ settings.color_palette.background }}",
        "actions_display_style": "icon",
        "bubble_style": "custom",
        "bubble_background_color": "{{ settings.color_palette.foreground }}",
        "bubble_text_color": "{{ settings.color_palette.background }}",
        "enable_transparent_header_home": false,
        "enable_transparent_header_product": false,
        "enable_transparent_header_collection": false
      }
    },
    "gempages_header_slot": {
      "type": "_blocks",
      "name": "GemPages Platzhalter (Kopfbereich)",
      "settings": {
        "section_width": "page-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    }
  },
  "order": ["announcement_bar", "ticker", "header_section", "gempages_header_slot"]
}
