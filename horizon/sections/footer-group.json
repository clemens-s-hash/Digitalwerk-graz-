{
  "type": "footer",
  "name": "t:names.footer",
  "sections": {
    "gempages_footer_slot": {
      "type": "_blocks",
      "name": "GemPages Platzhalter (Fußbereich)",
      "settings": {
        "section_width": "page-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    },
    "footer_main": {
      "type": "footer",
      "blocks": {
        "menu_hauptmenue": {
          "type": "menu",
          "settings": {
            "menu": "main-menu",
            "heading": "Menü",
            "menu_spacing": 2,
            "heading_preset": "h6",
            "link_preset": "paragraph",
            "show_as_accordion": false
          }
        },
        "menu_rechtliches": {
          "type": "menu",
          "settings": {
            "menu": "rechtliches",
            "heading": "Rechtliches",
            "menu_spacing": 2,
            "heading_preset": "h6",
            "link_preset": "paragraph",
            "show_as_accordion": false
          }
        },
        "text_kontakt": {
          "type": "group",
          "settings": {
            "content_direction": "column",
            "horizontal_alignment_flex_direction_column": "flex-start",
            "gap": 16,
            "width": "fill",
            "height": "fit"
          },
          "blocks": {
            "kontakt_heading": {
              "type": "text",
              "settings": {
                "text": "<p>Kontakt</p>",
                "type_preset": "h6",
                "width": "100%",
                "alignment": "left"
              }
            },
            "kontakt_text": {
              "type": "text",
              "settings": {
                "text": "<p>Du benötigst Unterstützung? <br/>Wir sind für dich da!</p><p><strong>Kundenservice-Zeiten:</strong><br/>Montag – Freitag: 9:00 – 17:00 Uhr (MEZ)</p><p><strong>E-Mail: support@solenahome.com</strong></p><p><strong>Voraussichtliche Antwortzeit: </strong>Innerhalb von 24 Stunden</p><p><strong>Geschäftsanschrift:</strong><br/>Kärntnerstraße 1, B402</p><p>8020 Graz</p><p>Steiermark</p>",
                "type_preset": "rte",
                "width": "100%",
                "alignment": "left"
              }
            }
          },
          "block_order": ["kontakt_heading", "kontakt_text"]
        }
      },
      "block_order": ["menu_hauptmenue", "menu_rechtliches", "text_kontakt"],
      "name": "Fußbereich",
      "settings": {
        "section_width": "page-width",
        "gap": 40,
        "background_color": "{{ settings.color_palette.background }}",
        "padding-block-start": 64,
        "padding-block-end": 48
      }
    },
    "footer_utilities": {
      "type": "footer-utilities",
      "blocks": {
        "copyright": {
          "type": "footer-copyright",
          "settings": {
            "show_powered_by": false,
            "font_size": "0.75rem",
            "case": "none"
          }
        },
        "payment_icons": {
          "type": "payment-icons",
          "settings": {
            "horizontal_alignment": "flex-end",
            "gap": 8
          }
        }
      },
      "block_order": ["copyright", "payment_icons"],
      "name": "Fußzeile unten",
      "settings": {
        "section_width": "page-width",
        "gap": 24,
        "divider_thickness": 1,
        "divider_color": "{{ settings.color_palette.color2 }}",
        "background_color": "{{ settings.color_palette.background }}",
        "padding-block-start": 24,
        "padding-block-end": 24
      }
    }
  },
  "order": ["gempages_footer_slot", "footer_main", "footer_utilities"]
}
