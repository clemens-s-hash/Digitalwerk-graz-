{
  "sections": {
    "slideshow": {
      "type": "slideshow",
      "settings": {
        "slide_height": "large"
      },
      "blocks": {
        "slide": {
          "type": "_slide",
          "settings": {
            "image_1": "shopify://shop_images/hf_20260902_173914_1665b126-212b-4577-b96c-3446f36c38ab.png",
            "toggle_overlay": true,
            "overlay_color": "#0000001a",
            "padding-block-start": 48,
            "padding-block-end": 48,
            "padding-inline-start": 48,
            "padding-inline-end": 48
          },
          "blocks": {
            "heading": {
              "type": "text",
              "settings": {
                "text": "<h1>Entdecke Solena</h1>"
              }
            },
            "subheading": {
              "type": "text",
              "settings": {
                "text": "<p>Weil Design keine Ausnahme sein sollte</p>"
              }
            },
            "button": {
              "type": "button",
              "settings": {
                "label": "Finde jetzt deinen Stil",
                "link": "shopify://collections/all"
              }
            }
          },
          "block_order": [
            "heading",
            "subheading",
            "button"
          ]
        }
      },
      "block_order": [
        "slide"
      ]
    },
    "collections": {
      "type": "collection-list",
      "settings": {
        "collection_list": [
          "hangeleuchten",
          "deckenleuchten",
          "tischleuchten",
          "wandleuchten",
          "outdoor-leuchten"
        ],
        "columns": 5,
        "padding-block-start": 72,
        "padding-block-end": 88
      },
      "blocks": {
        "heading": {
          "type": "text",
          "settings": {
            "text": "<h2>Collections</h2>"
          }
        },
        "static-collection-card": {
          "type": "_collection-card",
          "static": true,
          "settings": {
            "placement": "below_image"
          },
          "blocks": {
            "collection-card-image": {
              "type": "_collection-card-image",
              "static": true,
              "settings": {
                "image_ratio": "square"
              }
            },
            "collection-title": {
              "type": "collection-title"
            }
          },
          "block_order": [
            "collection-title"
          ]
        }
      },
      "block_order": [
        "heading"
      ]
    },
    "bestseller": {
      "type": "product-list",
      "settings": {
        "collection": "bestseller",
        "max_products": 16,
        "columns": 5,
        "padding-block-start": 36,
        "padding-block-end": 36
      },
      "blocks": {
        "static-header": {
          "type": "_product-list-content",
          "static": true,
          "blocks": {
            "heading": {
              "type": "_product-list-text",
              "settings": {
                "text": "<h2>Solena Bestseller</h2>",
                "type_preset": "h1"
              }
            }
          },
          "block_order": [
            "heading"
          ]
        },
        "static-product-card": {
          "type": "_product-card",
          "static": true,
          "blocks": {
            "gallery": {
              "type": "_product-card-gallery"
            },
            "title": {
              "type": "product-title"
            },
            "vendor": {
              "type": "solena-product-type",
              "settings": {
                "source": "vendor"
              }
            },
            "rating": {
              "type": "review"
            },
            "price": {
              "type": "price"
            }
          },
          "block_order": [
            "gallery",
            "title",
            "vendor",
            "rating",
            "price"
          ]
        }
      }
    },
    "media": {
      "type": "media-with-content",
      "settings": {
        "media_position": "right",
        "media_width": "narrow",
        "background_color": "#F2EDE5",
        "padding-block-start": 96,
        "padding-block-end": 96
      },
      "blocks": {
        "media": {
          "type": "_media-without-appearance",
          "static": true,
          "settings": {
            "image": "shopify://shop_images/hf_20260902_183544_5640de0a-023a-46bd-9a55-b126b3989ad1.png"
          }
        },
        "content": {
          "type": "_content-without-appearance",
          "static": true,
          "blocks": {
            "heading": {
              "type": "text",
              "settings": {
                "text": "<h3>Ein Statement für dein Zuhause</h3>",
                "width": "100%",
                "alignment": "center",
                "max_width": "none"
              }
            },
            "text": {
              "type": "text",
              "settings": {
                "text": "<p>Wo nordische Ruhe auf Design trifft</p>",
                "width": "100%",
                "alignment": "center",
                "max_width": "none"
              }
            },
            "button": {
              "type": "button",
              "settings": {
                "label": "Mehr lesen",
                "link": "shopify://pages/uber-uns"
              }
            }
          },
          "block_order": [
            "heading",
            "text",
            "button"
          ]
        }
      }
    },
    "featured_product": {
      "type": "featured-product-information",
      "settings": {
        "equal_columns": true,
        "padding-block-start": 88,
        "padding-block-end": 88
      },
      "blocks": {
        "product-details": {
          "type": "_product-details",
          "static": true,
          "blocks": {
            "eyebrow": {
              "type": "text",
              "settings": {
                "text": "<p>Immer im Blick</p>",
                "type_preset": "custom",
                "case": "uppercase"
              }
            },
            "title": {
              "type": "product-title"
            },
            "price": {
              "type": "price"
            },
            "variant-picker": {
              "type": "variant-picker"
            },
            "buy-buttons": {
              "type": "buy-buttons"
            },
            "share": {
              "type": "solena-share"
            }
          },
          "block_order": [
            "eyebrow",
            "title",
            "price",
            "variant-picker",
            "buy-buttons",
            "share"
          ]
        }
      }
    },
    "trends": {
      "type": "product-list",
      "settings": {
        "collection": "trends",
        "max_products": 4,
        "columns": 4,
        "padding-block-start": 36,
        "padding-block-end": 36
      },
      "blocks": {
        "static-header": {
          "type": "_product-list-content",
          "static": true,
          "settings": {
            "content_direction": "row",
            "horizontal_alignment": "space-between",
            "vertical_alignment": "flex-end",
            "align_baseline": true
          },
          "blocks": {
            "heading": {
              "type": "_product-list-text",
              "settings": {
                "text": "<h2>Trends 2026</h2>"
              }
            },
            "view-all": {
              "type": "_product-list-button",
              "settings": {
                "label": "Alle ansehen"
              }
            }
          },
          "block_order": [
            "heading",
            "view-all"
          ]
        },
        "static-product-card": {
          "type": "_product-card",
          "static": true,
          "blocks": {
            "gallery": {
              "type": "_product-card-gallery"
            },
            "title": {
              "type": "product-title"
            },
            "vendor": {
              "type": "solena-product-type",
              "settings": {
                "source": "vendor"
              }
            },
            "price": {
              "type": "price"
            }
          },
          "block_order": [
            "gallery",
            "title",
            "vendor",
            "price"
          ]
        }
      }
    },
    "testimonials": {
      "type": "section",
      "settings": {
        "gap": 32,
        "padding-block-start": 96,
        "padding-block-end": 96
      },
      "blocks": {
        "heading": {
          "type": "text",
          "settings": {
            "text": "<h3>Zufriedenheit ist unsere Voraussetzung</h3>",
            "width": "100%",
            "alignment": "center",
            "max_width": "none"
          }
        },
        "row": {
          "type": "group",
          "settings": {
            "content_direction": "row",
            "vertical_alignment": "flex-start",
            "gap": 24
          },
          "blocks": {
            "testimonial-1": {
              "type": "solena-testimonial",
              "settings": {
                "heading": "Schnell geliefert, top Qualität!",
                "text": "<p>Leuchte war in einer Woche da und hat unserem Esszimmer endlich das gewisse Etwas verliehen!</p>",
                "author": "Julia S.",
                "show_quote": true
              }
            },
            "testimonial-2": {
              "type": "solena-testimonial",
              "settings": {
                "heading": "Designer-pieces",
                "text": "<p>Hab mir 2x die Spira Nachttischleuchte gekauft, kommt echt gut wenn man Ahnung hat wie man sie kombiniert. Wurde bis jetzt von jedem gefragt wo ich die gekauft habe. Top!</p>",
                "author": "Thomas W.",
                "show_quote": true
              }
            },
            "testimonial-3": {
              "type": "solena-testimonial",
              "settings": {
                "heading": "Vorbildlicher Kundenservice",
                "text": "<p>Hatte eine Frage zu meiner Bestellung und bekam innerhalb weniger Stunden eine hilfreiche Antwort. So muss das sein!</p>",
                "author": "Andrea Z.",
                "show_quote": true
              }
            }
          },
          "block_order": [
            "testimonial-1",
            "testimonial-2",
            "testimonial-3"
          ]
        }
      },
      "block_order": [
        "heading",
        "row"
      ]
    }
  },
  "order": [
    "slideshow",
    "collections",
    "bestseller",
    "media",
    "featured_product",
    "trends",
    "testimonials"
  ]
}
