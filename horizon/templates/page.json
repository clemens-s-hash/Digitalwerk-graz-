          "settings": {
            "product_card_gap": 0,
            "border": "none",
            "border_radius": 0
          },
          "blocks": {
            "card-gallery": {
              "type": "_product-card-gallery",
              "settings": {
                "image_ratio": "square",
                "border_radius": 2
              }
            },
            "card-topline": {
              "type": "_product-card-group",
              "settings": {
                "content_direction": "row",
                "vertical_on_mobile": true,
                "horizontal_alignment": "space-between",
                "vertical_alignment": "flex-start",
                "align_baseline": false,
                "gap": 12,
                "width": "fill",
                "height": "fit"
              },
              "blocks": {
                "card-titles": {
                  "type": "_product-card-group",
                  "settings": {
                    "content_direction": "column",
                    "horizontal_alignment_flex_direction_column": "flex-start",
                    "gap": 0,
                    "width": "fill",
                    "height": "fit"
                  },
                  "blocks": {
                    "card-title": {
                      "type": "product-title",
                      "settings": {
                        "width": "100%",
                        "alignment": "left",
                        "type_preset": "custom",
                        "font": "var(--font-heading--family)",
                        "font_size": "1.125rem",
                        "line_height": "tight",
                        "max_width": "none"
                      }
                    },
                    "card-type": {
                      "type": "solena-product-type",
                      "settings": {
                        "source": "type_then_vendor",
                        "alignment": "left"
                      }
                    }
                  },
                  "block_order": [
                    "card-title",
                    "card-type"
                  ]
                }
              },
              "block_order": [
                "card-titles"
              ]
            },
            "card-rule": {
              "type": "solena-hairline",
              "settings": {
                "thickness": 1,
                "padding-block-start": 14,
                "padding-block-end": 0
              }
            },
            "card-price": {
              "type": "price",
              "settings": {
                "show_sale_price_first": true,
                "width": "100%",
                "alignment": "left",
                "type_preset": "custom",
                "font": "var(--font-body--family)",
                "font_size": "1rem"
              }
            },
            "card-swatches": {
              "type": "solena-card-swatches",
              "settings": {
                "swatch_limit": 6,
                "swatch_size": 18,
                "alignment": "flex-start",
                "padding-block-start": 14
              }
            }
          },
          "block_order": [
            "card-gallery",
            "card-topline",
            "card-rule",
            "card-price",
            "card-swatches"
          ]
        }
      }
    }
  },
  "order": [
    "main",
    "gempages_page_1",
    "gempages_page_2",
    "trends"
  ]
}
