{
  "sections": {
    "main": {
      "type": "main-page",
      "settings": {
        "gap": 24,
        "padding-block-start": 64,
        "padding-block-end": 64
      },
      "blocks": {
        "page-content": {
          "type": "page-content",
          "settings": {}
        }
      },
      "block_order": [
        "page-content"
      ]
    },
    "gempages_page_1": {
      "type": "_blocks",
      "name": "GemPages Platzhalter 1",
      "settings": {
        "section_width": "page-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    },
    "gempages_page_2": {
      "type": "_blocks",
      "name": "GemPages Platzhalter 2",
      "settings": {
        "section_width": "page-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    },
    "trends": {
      "type": "product-list",
      "settings": {
        "collection": "trends",
        "layout_type": "grid",
        "carousel_on_mobile": false,
        "max_products": 4,
        "columns": 4,
        "mobile_columns": "2",
        "columns_gap": 24,
        "rows_gap": 56,
        "section_width": "page-width",
        "gap": 32,
        "padding-block-start": 88,
        "padding-block-end": 88
      },
      "blocks": {
        "static-header": {
          "type": "_product-list-content",
          "static": true,
          "settings": {
            "content_direction": "row",
            "horizontal_alignment": "space-between",
            "vertical_alignment": "flex-end",
            "align_baseline": true,
            "gap": 12,
            "width": "fill"
          },
          "blocks": {
            "pl-title": {
              "type": "_product-list-text",
              "settings": {
                "text": "<h2>Trends 2026</h2>",
                "type_preset": "h2",
                "font": "var(--font-heading--family)",
                "width": "fit-content",
                "alignment": "left",
                "max_width": "none"
              }
            },
            "pl-view-all": {
              "type": "_product-list-button",
              "settings": {
                "label": "Alle ansehen",
                "style_class": "button-secondary"
              }
            }
          },
          "block_order": [
            "pl-title",
            "pl-view-all"
          ]
