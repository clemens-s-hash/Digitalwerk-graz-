/*
 * ------------------------------------------------------------
 * Erzeugt von tools/templates.py aus dem Shrine-Export.
 *
 * Diese Datei darf der Shopify-Theme-Editor ueberschreiben.
 * Nach Aenderungen am Generator neu erzeugen, nicht hier und
 * dort gleichzeitig editieren.
 * ------------------------------------------------------------
 */
{
  "sections": {
    "search": {
      "type": "search-header",
      "blocks": {
        "heading": {
          "type": "_heading",
          "static": true,
          "settings": {
            "type_preset": "h2",
            "font": "var(--font-body--family)",
            "line_height": "normal",
            "letter_spacing": "normal",
            "case": "none",
            "wrap": "pretty",
            "read_only": true,
            "alignment": "left",
            "show_alignment": true,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {}
        },
        "search": {
          "type": "_search-input",
          "static": true,
          "settings": {
            "width": "custom",
            "custom_width": 50
          },
          "blocks": {}
        }
      },
      "settings": {
        "alignment": "flex-start",
        "background_color": "{{ settings.color_palette.background }}",
        "padding-block-start": 40,
        "padding-block-end": 0
      }
    },
    "main": {
      "type": "search-results",
      "blocks": {
        "filters": {
          "type": "filters",
          "static": true,
          "settings": {
            "enable_filtering": true,
            "filter_style": "horizontal",
            "filter_width": "centered",
            "text_label_case": "default",
            "show_swatch_label": false,
            "show_filter_label": false,
            "enable_sorting": true,
            "enable_grid_density": true,
            "padding-block-start": 8,
            "padding-block-end": 8,
            "padding-inline-start": 0,
            "padding-inline-end": 0,
            "facets_margin_bottom": 8,
            "facets_margin_right": 20
          },
          "blocks": {}
        },
        "product-card": {
          "type": "_product-card",
          "static": true,
          "settings": {
            "product_card_gap": 0,
            "border": "none",
            "border_radius": 0
          },
          "blocks": {
            "card-gallery": {
              "type": "_product-card-gallery",
              "settings": {
                "image_ratio": "square",
                "border_radius": 2
              }
            },
            "card-topline": {
              "type": "_product-card-group",
              "settings": {
                "content_direction": "row",
                "vertical_on_mobile": true,
                "horizontal_alignment": "space-between",
                "vertical_alignment": "flex-start",
                "align_baseline": false,
                "gap": 12,
                "width": "fill",
                "height": "fit"
              },
              "blocks": {
                "card-titles": {
                  "type": "_product-card-group",
                  "settings": {
                    "content_direction": "column",
                    "horizontal_alignment_flex_direction_column": "flex-start",
                    "gap": 0,
                    "width": "fill",
                    "height": "fit"
                  },
                  "blocks": {
                    "card-title": {
                      "type": "product-title",
                      "settings": {
                        "width": "100%",
                        "alignment": "left",
                        "type_preset": "custom",
                        "font": "var(--font-heading--family)",
                        "font_size": "1.125rem",
                        "line_height": "tight",
                        "max_width": "none"
                      }
                    },
                    "card-type": {
                      "type": "solena-product-type",
                      "settings": {
                        "source": "type_then_vendor",
                        "alignment": "left"
                      }
                    }
                  },
                  "block_order": [
                    "card-title",
                    "card-type"
                  ]
                }
              },
              "block_order": [
                "card-titles"
              ]
            },
            "card-rule": {
              "type": "solena-hairline",
              "settings": {
                "thickness": 1,
                "padding-block-start": 14,
                "padding-block-end": 0
              }
            },
            "card-price": {
              "type": "price",
              "settings": {
                "show_sale_price_first": true,
                "width": "100%",
                "alignment": "left",
                "type_preset": "custom",
                "font": "var(--font-body--family)",
                "font_size": "1rem"
              }
            },
            "card-swatches": {
              "type": "solena-card-swatches",
              "settings": {
                "swatch_limit": 6,
                "swatch_size": 18,
                "alignment": "flex-start",
                "padding-block-start": 14
              }
            }
          },
          "block_order": [
            "card-gallery",
            "card-topline",
            "card-rule",
            "card-price",
            "card-swatches"
          ]
        }
      },
      "settings": {
        "layout_type": "grid",
        "product_card_size": "medium",
        "mobile_product_card_size": "small",
        "product_grid_width": "centered",
        "full_width_on_mobile": true,
        "columns_gap_horizontal": 16,
        "columns_gap_vertical": 24,
        "padding-inline-start": 0,
        "padding-inline-end": 0,
        "background_color": "{{ settings.color_palette.background }}",
        "padding-block-start": 40,
        "padding-block-end": 40
      }
    },
    "newsletter": {
      "type": "section",
      "settings": {
        "content_direction": "column",
        "horizontal_alignment_flex_direction_column": "center",
        "gap": 16,
        "section_width": "page-width",
        "background_color": "#F2EDE5",
        "padding-block-start": 88,
        "padding-block-end": 88
      },
      "blocks": {
        "nl-heading": {
          "type": "text",
          "settings": {
            "text": "<h2>Subscribe to our emails</h2>",
            "type_preset": "h2",
            "font": "var(--font-heading--family)",
            "width": "100%",
            "alignment": "center",
            "max_width": "none"
          }
        },
        "nl-text": {
          "type": "text",
          "settings": {
            "text": "<p>Join our email list for exclusive offers and the latest news.</p>",
            "type_preset": "rte",
            "width": "100%",
            "alignment": "center",
            "max_width": "normal"
          }
        },
        "nl-form": {
          "type": "email-signup",
          "settings": {
            "width": "custom",
            "custom_width": 50,
            "border_style": "all",
            "border_width": 1,
            "border_radius": 0,
            "label": "Sign up",
            "style_class": "button",
            "display_type": "text",
            "integrated_button": false
          }
        }
      },
      "block_order": [
        "nl-heading",
        "nl-text",
        "nl-form"
      ]
    }
  },
  "order": [
    "search",
    "main",
    "newsletter"
  ]
}
