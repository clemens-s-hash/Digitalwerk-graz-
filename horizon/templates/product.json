{
  "sections": {
    "main": {
      "type": "product-information",
      "settings": {
        "content_width": "content-center-aligned",
        "desktop_media_position": "left",
        "gap": 32,
        "enable_sticky_add_to_cart": false,
        "padding-block-start": 32,
        "padding-block-end": 88
      },
      "blocks": {
        "media-gallery": {
          "type": "_product-media-gallery",
          "static": true,
          "settings": {
            "media_presentation": "carousel",
            "slideshow_controls_style": "thumbnails",
            "slideshow_mobile_controls_style": "thumbnails",
            "thumbnail_position": "bottom",
            "thumbnail_radius": 0,
            "aspect_ratio": "adapt",
            "constrain_to_viewport": true,
            "media_fit": "contain",
            "media_radius": 2,
            "extend_media": false,
            "zoom": true,
            "video_loop": false,
            "hide_variants": false
          }
        },
        "product-details": {
          "type": "_product-details",
          "static": true,
          "settings": {
            "width": "fill",
            "details_position": "flex-start",
            "gap": 20,
            "sticky_details_desktop": true,
            "padding-block-start": 0,
            "padding-block-end": 24
          },
          "blocks": {
            "title": {
              "type": "product-title",
              "settings": {
                "width": "100%",
                "alignment": "left",
                "type_preset": "h3",
                "font": "var(--font-heading--family)",
                "max_width": "none"
              }
            },
            "price": {
              "type": "price",
              "settings": {
                "show_sale_price_first": true,
                "width": "100%",
                "alignment": "left",
                "type_preset": "custom",
                "font": "var(--font-body--family)",
                "font_size": "1.25rem"
              }
            },
            "emoji-benefits": {
              "type": "solena-emoji-benefits",
              "disabled": true,
              "settings": {
                "benefits": "<p>🙌 Benefit</p><p>💪 Benefit</p><p>🌟 Benefit</p>"
              }
            },
            "variant-picker": {
              "type": "variant-picker",
              "settings": {}
            },
            "quantity": {
              "type": "quantity",
              "disabled": true,
              "settings": {}
            },
            "buy-buttons": {
              "type": "buy-buttons",
              "settings": {
                "stacking": false,
                "show_pickup_availability": true
