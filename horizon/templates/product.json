            "text": "<h2>Häufig gestellte Fragen</h2>",
            "type_preset": "h3",
            "font": "var(--font-heading--family)",
            "width": "100%",
            "alignment": "center",
            "max_width": "none"
          }
        },
        "faq-accordion": {
          "type": "accordion",
          "settings": {
            "icon": "caret",
            "dividers": true,
