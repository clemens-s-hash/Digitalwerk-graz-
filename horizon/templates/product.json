                  "type": "accelerated-checkout",
                  "static": true,
                  "settings": {}
                }
              }
            },
            "payment-icons": {
              "type": "payment-icons",
              "settings": {
                "horizontal_alignment": "flex-start",
                "gap": 8
              }
            },
            "tabs": {
              "type": "accordion",
              "settings": {
                "icon": "caret",
                "dividers": true,
                "type_preset": "h5",
                "divider_color": "{{ settings.color_palette.color2 }}"
              },
              "blocks": {
                "tab-1": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "Produktbeschreibung",
                    "icon": "clipboard"
                  },
                  "blocks": {
                    "tab-body-1": {
                      "type": "product-description",
                      "settings": {
                        "width": "100%"
                      }
                    }
                  },
                  "block_order": [
                    "tab-body-1"
                  ]
                },
                "tab-2": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "Versandinformationen",
                    "icon": "truck"
                  },
                  "blocks": {
                    "tab-body-2": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Wir bieten kostenlosen Versand innerhalb Deutschlands an.</p><ul><li><strong>Bearbeitungszeit:</strong> 1–2 Werktage</li><li><strong>Lieferzeit:</strong> 3–7 Werktage</li></ul><p>Der Versand erfolgt zuverlässig mit DHL, inklusive Sendungsverfolgung.</p><p>Weitere Informationen findest du in unserer Versandrichtlinie.</p>",
                        "type_preset": "rte",
                        "width": "100%",
                        "alignment": "left",
                        "max_width": "none"
                      }
                    }
                  },
                  "block_order": [
                    "tab-body-2"
                  ]
                },
                "tab-3": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "Rückgabeinformationen",
                    "icon": "return"
                  },
                  "blocks": {
                    "tab-body-3": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Rücksendungen sind innerhalb von 30 Tagen nach Erhalt der Ware möglich.<br/>Der Kaufpreis wird nach Eingang und Prüfung der Rücksendung erstattet.<br/>Die Rücksendekosten trägt der Käufer.</p><p>Weitere Informationen finden Sie in unserer Rückerstattungsrichtlinie.</p>",
                        "type_preset": "rte",
                        "width": "100%",
                        "alignment": "left",
                        "max_width": "none"
                      }
                    }
                  },
                  "block_order": [
                    "tab-body-3"
                  ]
                }
              },
              "block_order": [
                "tab-1",
                "tab-2",
                "tab-3"
              ]
            },
            "app-review-summary-1": {
              "type": "solena-app-slot",
              "settings": {
                "app_name": "Iconic Blocks",
                "block_name": "Review Summary",
                "note": "Trustpilot-Zeile: 4,5 Sterne, „Über 35.000 Bewertungen\", Link at.trustpilot.com"
              }
            },
            "app-benefits": {
              "type": "solena-app-slot",
              "settings": {
                "app_name": "Iconic Blocks",
                "block_name": "Benefits",
                "note": "liest product.metafields.custom.selling_point_1 bis _4"
              }
            },
            "app-judgeme-badge": {
              "type": "solena-app-slot",
              "settings": {
                "app_name": "Judge.me",
                "block_name": "Preview Badge",
                "note": "Sterne-Vorschau unter dem Titel"
              }
            },
            "app-review-summary-2": {
              "type": "solena-app-slot",
              "settings": {
                "app_name": "Iconic Blocks",
                "block_name": "Review Summary (zweite Instanz)",
                "note": "im Original mit dem Platzhaltertext „20,921 reviews\", ohne Link"
              }
            },
            "sticky-atc": {
              "type": "solena-sticky-atc",
              "settings": {
                "display_when": "after_scroll",
                "button_label": "Zum Warenkorb",
                "show_image": true,
                "show_price": true,
                "show_price_badge": true
              }
            }
          },
          "block_order": [
            "app-review-summary-1",
            "title",
            "app-benefits",
            "app-judgeme-badge",
            "app-review-summary-2",
            "price",
            "emoji-benefits",
            "variant-picker",
            "quantity",
            "buy-buttons",
            "sticky-atc",
            "payment-icons",
            "tabs"
          ]
        }
      }
    },
    "related_products": {
