              },
              "blocks": {
                "card-titles": {
                  "type": "_product-card-group",
                  "settings": {
                    "content_direction": "column",
                    "horizontal_alignment_flex_direction_column": "flex-start",
                    "gap": 0,
                    "width": "fill",
                    "height": "fit"
                  },
                  "blocks": {
                    "card-title": {
                      "type": "product-title",
                      "settings": {
                        "width": "100%",
                        "alignment": "left",
