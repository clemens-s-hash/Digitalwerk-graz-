                    "text": "<p>support@solenahome.com</p>",
                    "type_preset": "rte",
                    "width": "100%",
                    "alignment": "left",
                    "max_width": "none"
                  }
                }
              },
              "block_order": [
                "text-8"
              ]
            }
          },
          "block_order": [
            "row-1",
            "row-2",
            "row-3",
            "row-4",
            "row-5",
            "row-6",
            "row-7",
            "row-8"
