            "divider_color": "{{ settings.color_palette.color2 }}"
          },
          "blocks": {
            "row-1": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Wie lange dauert der Versand?",
                "open_by_default": false,
                "icon": "none"
              },
              "blocks": {
                "text-1": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Die Bearbeitung dauert in der Regel 1 bis 2 Werktage. Die Lieferzeit beträgt meist ca. 3 bis 7 Werktage.</p>",
                    "type_preset": "rte",
                    "width": "100%",
                    "alignment": "left",
                    "max_width": "none"
                  }
                }
              },
              "block_order": [
                "text-1"
              ]
            },
            "row-2": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Ist der Versand kostenlos?",
                "open_by_default": false,
                "icon": "none"
              },
              "blocks": {
                "text-2": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Ja, der Versand innerhalb Deutschlands und Österreich ist kostenlos.</p>",
                    "type_preset": "rte",
                    "width": "100%",
                    "alignment": "left",
                    "max_width": "none"
                  }
                }
              },
              "block_order": [
                "text-2"
              ]
            },
            "row-3": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Wie kann ich meine Bestellung verfolgen?",
                "open_by_default": false,
                "icon": "none"
              },
              "blocks": {
                "text-3": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Sobald die Bestellung versendet wurde, erhalten Sie eine E-Mail mit einem Tracking-Link.</p>",
                    "type_preset": "rte",
                    "width": "100%",
                    "alignment": "left",
                    "max_width": "none"
                  }
                }
              },
              "block_order": [
                "text-3"
              ]
            },
            "row-4": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Wie lautet eure Rückgaberichtlinie?",
                "open_by_default": false,
                "icon": "none"
              },
              "blocks": {
                "text-4": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Sie können Artikel innerhalb von 30 Tagen ab Zustellung zurückgeben. Die Artikel müssen ungetragen, unbenutzt, vollständig und im Originalzustand mit Etiketten sein. Die Rücksendekosten trägt der Kunde.</p>",
                    "type_preset": "rte",
                    "width": "100%",
                    "alignment": "left",
                    "max_width": "none"
                  }
                }
              },
              "block_order": [
                "text-4"
              ]
            },
            "row-5": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Welche Zahlungsmethoden bietet ihr an?",
                "open_by_default": false,
                "icon": "none"
              },
              "blocks": {
                "text-5": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Visa, Mastercard, Maestro, SEPA, American Express, Apple Pay und PayPal.</p>",
                    "type_preset": "rte",
                    "width": "100%",
                    "alignment": "left",
                    "max_width": "none"
                  }
                }
              },
              "block_order": [
                "text-5"
              ]
            },
            "row-6": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Ist die Zahlung auf eurer Website sicher?",
                "open_by_default": false,
                "icon": "none"
              },
              "blocks": {
                "text-6": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Ja. Ihre Zahlung wird über sichere, verschlüsselte Verbindungen verarbeitet. Zusätzlich stehen Ihnen bekannte Zahlungsarten zur Verfügung.</p>",
                    "type_preset": "rte",
                    "width": "100%",
                    "alignment": "left",
                    "max_width": "none"
                  }
                }
              },
              "block_order": [
                "text-6"
              ]
            },
            "row-7": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Wie geht ihr mit meinen Daten um?",
                "open_by_default": false,
                "icon": "none"
              },
              "blocks": {
                "text-7": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Wir nutzen Ihre Daten nur zur Bestellabwicklung und zur Bereitstellung unseres Services. Ihre Daten werden nicht für fremde Werbezwecke verkauft.</p>",
                    "type_preset": "rte",
                    "width": "100%",
                    "alignment": "left",
