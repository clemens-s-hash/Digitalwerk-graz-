{
  "sections": {
    "cart-section": {
      "type": "main-cart",
      "blocks": {
        "cart-page-title": {
          "type": "_cart-title",
          "static": true,
          "settings": {
            "title": "Cart",
            "show_count": true,
            "type_preset": "h4",
            "alignment": "left",
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {}
        },
        "cart-page-items": {
          "type": "_cart-products",
          "static": true,
          "settings": {
            "gap": 24,
            "image_ratio": "portrait",
            "dividers": true,
            "vendor": false,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {}
        },
        "cart-page-summary": {
          "type": "_cart-summary",
          "static": true,
          "settings": {
            "extend_summary": true,
            "background_color": "{{ settings.color_palette.color2 }}",
            "border": "none",
            "border_width": 1,
            "border_opacity": 100,
            "border_radius": 0
          },
          "blocks": {}
        }
      },
      "settings": {
        "section_width": "page-width",
        "background_color": "{{ settings.color_palette.background }}",
        "padding-block-start": 40,
        "padding-block-end": 32
      }
    },
    "alle_produkte": {
      "type": "product-list",
      "settings": {
        "collection": "alleprodukte",
        "layout_type": "grid",
        "carousel_on_mobile": false,
        "max_products": 4,
        "columns": 4,
        "mobile_columns": "2",
        "columns_gap": 24,
        "rows_gap": 56,
        "section_width": "page-width",
        "gap": 32,
        "padding-block-start": 88,
        "padding-block-end": 88
      },
      "blocks": {
        "static-header": {
          "type": "_product-list-content",
          "static": true,
          "settings": {
            "content_direction": "row",
            "horizontal_alignment": "space-between",
            "vertical_alignment": "flex-end",
            "align_baseline": true,
            "gap": 12,
            "width": "fill"
          },
          "blocks": {
            "pl-title": {
              "type": "_product-list-text",
              "settings": {
                "text": "<h2>Entdecke unsere Produkte</h2>",
                "type_preset": "h2",
                "font": "var(--font-heading--family)",
                "width": "fit-content",
                "alignment": "left",
                "max_width": "none"
              }
            },
            "pl-view-all": {
              "type": "_product-list-button",
              "settings": {
                "label": "Alle ansehen",
                "style_class": "button-secondary"
              }
            }
          },
          "block_order": [
            "pl-title",
            "pl-view-all"
          ]
        },
        "static-product-card": {
          "type": "_product-card",
          "static": true,
          "settings": {
            "product_card_gap": 0,
            "border": "none",
            "border_radius": 0
          },
          "blocks": {
            "card-gallery": {
              "type": "_product-card-gallery",
              "settings": {
                "image_ratio": "square",
                "border_radius": 2
              }
            },
            "card-topline": {
              "type": "_product-card-group",
              "settings": {
                "content_direction": "row",
                "vertical_on_mobile": true,
                "horizontal_alignment": "space-between",
                "vertical_alignment": "flex-start",
                "align_baseline": false,
                "gap": 12,
                "width": "fill",
                "height": "fit"
              },
              "blocks": {
                "card-titles": {
                  "type": "_product-card-group",
                  "settings": {
                    "content_direction": "column",
                    "horizontal_alignment_flex_direction_column": "flex-start",
                    "gap": 0,
                    "width": "fill",
                    "height": "fit"
                  },
                  "blocks": {
                    "card-title": {
                      "type": "product-title",
                      "settings": {
                        "width": "100%",
                        "alignment": "left",
                        "type_preset": "custom",
                        "font": "var(--font-heading--family)",
                        "font_size": "1.125rem",
                        "line_height": "tight",
                        "max_width": "none"
                      }
                    },
                    "card-type": {
                      "type": "solena-product-type",
                      "settings": {
                        "source": "type_then_vendor",
                        "alignment": "left"
                      }
                    }
                  },
                  "block_order": [
                    "card-title",
                    "card-type"
                  ]
                }
              },
              "block_order": [
                "card-titles"
              ]
            },
            "card-rule": {
              "type": "solena-hairline",
              "settings": {
                "thickness": 1,
                "padding-block-start": 14,
                "padding-block-end": 0
              }
            },
            "card-price": {
              "type": "price",
              "settings": {
                "show_sale_price_first": true,
                "width": "100%",
                "alignment": "left",
                "type_preset": "custom",
                "font": "var(--font-body--family)",
                "font_size": "1rem"
              }
            },
            "card-swatches": {
              "type": "solena-card-swatches",
              "settings": {
                "swatch_limit": 6,
                "swatch_size": 18,
                "alignment": "flex-start",
                "padding-block-start": 14
              }
            }
          },
          "block_order": [
            "card-gallery",
            "card-topline",
            "card-rule",
            "card-price",
            "card-swatches"
          ]
        }
      }
