          "blocks": {
            "pr-heading-2": {
              "type": "text",
              "settings": {
                "text": "<h2>Die Kunst des Weglassens</h2>",
                "type_preset": "h2",
                "font": "var(--font-heading--family)",
                "width": "fit-content",
                "alignment": "left",
                "max_width": "none"
