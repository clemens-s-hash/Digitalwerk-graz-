                "font": "var(--font-heading--family)",
                "width": "fit-content",
                "alignment": "left",
                "max_width": "none"
              }
            },
            "pr-text-1": {
              "type": "text",
              "settings": {
                "text": "<p>Die Idee ist einfach: Man nehme zwei flache Scheiben und drehe die untere ein Stück gegen die obere. Was entsteht, ist ein schmaler Spalt, durch den das Licht seitlich entweicht und die Decke mitbeleuchtet. Von unten bleibt die Form geschlossen und ruhig. Erst aus dem Winkel zeigt sich, dass hier zwei Ebenen übereinander liegen.</p>",
                "type_preset": "rte",
                "width": "100%",
                "alignment": "left",
                "max_width": "normal"
              }
            }
          },
