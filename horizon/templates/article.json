/*
 * ------------------------------------------------------------
 * Erzeugt von tools/templates.py aus dem Shrine-Export.
 *
 * Diese Datei darf der Shopify-Theme-Editor ueberschreiben.
 * Nach Aenderungen am Generator neu erzeugen, nicht hier und
 * dort gleichzeitig editieren.
 * ------------------------------------------------------------
 */
{
  "sections": {
    "section": {
      "type": "main-blog-post",
      "blocks": {
        "blog-post-title": {
          "type": "text",
          "name": "t:names.title",
          "settings": {
            "text": "<h1>{{ article.title }}</h1>",
            "width": "100%",
            "max_width": "normal",
            "alignment": "center",
            "type_preset": "h2",
            "font": "var(--font-body--family)",
            "line_height": "normal",
            "letter_spacing": "normal",
            "case": "none",
            "wrap": "pretty",
            "background": false,
            "background_color": "#00000026",
            "corner_radius": 0,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {}
        },
        "blog-post-details": {
          "type": "_blog-post-info-text",
          "name": "t:names.details",
          "settings": {
            "show_date": true,
            "show_author": false,
            "alignment": "center",
            "show_alignment": true,
            "padding-block-start": 0,
            "padding-block-end": 0
          },
          "blocks": {}
        },
        "blog-post-image": {
          "type": "image",
          "name": "t:names.featured_image",
          "settings": {
            "image": "{{ article.image }}",
            "width": "fill",
            "custom_width": 100,
            "width_mobile": "fill",
            "custom_width_mobile": 100,
            "height": "fit",
            "border": "none",
            "border_width": 1,
            "border_opacity": 100,
            "border_radius": 0,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {}
        },
        "blog-post-content": {
          "type": "_blog-post-content",
          "settings": {},
          "blocks": {}
        }
      },
      "block_order": [
        "blog-post-title",
        "blog-post-details",
        "blog-post-image",
        "blog-post-content"
      ],
      "settings": {
        "content_direction": "column",
        "gap": 32,
        "background_color": "{{ settings.color_palette.background }}",
        "padding-block-start": 40,
        "padding-block-end": 80
      }
    },
    "newsletter": {
      "type": "section",
      "settings": {
        "content_direction": "column",
        "horizontal_alignment_flex_direction_column": "center",
        "gap": 16,
        "section_width": "page-width",
        "background_color": "#F2EDE5",
        "padding-block-start": 88,
        "padding-block-end": 88
      },
      "blocks": {
        "nl-heading": {
          "type": "text",
          "settings": {
            "text": "<h2>Subscribe to our emails</h2>",
            "type_preset": "h2",
            "font": "var(--font-heading--family)",
            "width": "100%",
            "alignment": "center",
            "max_width": "none"
          }
        },
        "nl-text": {
          "type": "text",
          "settings": {
            "text": "<p>Join our email list for exclusive offers and the latest news.</p>",
            "type_preset": "rte",
            "width": "100%",
            "alignment": "center",
            "max_width": "normal"
          }
        },
        "nl-form": {
          "type": "email-signup",
          "settings": {
            "width": "custom",
            "custom_width": 50,
            "border_style": "all",
            "border_width": 1,
            "border_radius": 0,
            "label": "Sign up",
            "style_class": "button",
            "display_type": "text",
            "integrated_button": false
          }
        }
      },
      "block_order": [
        "nl-heading",
        "nl-text",
        "nl-form"
      ]
    }
  },
  "order": [
    "section",
    "newsletter"
  ]
}
