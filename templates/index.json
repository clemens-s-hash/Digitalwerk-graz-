          }
        },
        "column_iBheEP": {
          "type": "column",
          "settings": {
            "title": "Vorbildlicher Kundenservice",
            "text": "<p>Hatte eine Frage zu meiner Bestellung und bekam innerhalb weniger Stunden eine hilfreiche Antwort. So muss das sein!</p>",
            "author": "Andrea Z."
          }
        }
